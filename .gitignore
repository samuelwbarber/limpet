# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Logs / scratch
*.log
/tmp/

# Electron app
app/node_modules/
app/dist/
app/dist-*/
app/out/
app/_run.*
app/local-ai/

# Demo recorder workdir (see tools/demo/README.md; only the scripts are tracked)
tools/demo/node_modules/
tools/demo/vids/
tools/demo/gifs/
tools/demo/package.json
tools/demo/package-lock.json

# zsh writes this beside the rc files it loads (a distro-level compinit); never ship it
shell/rc/zsh/.zcompdump*

# Local shell history must never be committed or bundled
shell/rc/zsh/.zsh_history*
