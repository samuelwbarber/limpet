{
  "name": "limpet",
  "productName": "limpet",
  "version": "0.1.1",
  "description": "limpet - a tabbed terminal with resilient SSH, inline images, drag-and-drop upload and any number of coding-agent accounts (Windows, macOS, Linux)",
  "author": "samuelwbarber",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "setup": "npm install --ignore-scripts --no-audit --no-fund && node node_modules/electron/install.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "demo:backdrop": "node scripts/show-backdrop-demo.js",
    "setup:backdrop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-backdrop.ps1",
    "setup:backdrop:unix": "bash scripts/setup-local-backdrop.sh",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.js && node tests/ctrlc.js && node tests/tabs-links.js && node tests/accounts.js && node tests/session-recovery.js && node tests/terminal-ui.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "io.github.samuelwbarber.limpet",
    "productName": "limpet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "scripts/setup-local-backdrop.ps1",
      "scripts/setup-local-backdrop.sh",
      "build/limpet.ico",
      "!**/*.pdb",
      "!node_modules/node-pty/{src,deps,third_party,scripts}/**"
    ],
    "asarUnpack": [
      "src/lock-holders.ps1",
      "scripts/setup-local-backdrop.ps1",
      "scripts/setup-local-backdrop.sh",
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "../shell",
        "to": "shell"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/limpet.ico",
      "files": [
        "!node_modules/node-pty/prebuilds/darwin-*/**",
        "!node_modules/node-pty/prebuilds/linux-*/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "limpet",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "files": [
        "!node_modules/node-pty/prebuilds/win32-*/**",
        "!node_modules/node-pty/prebuilds/linux-*/**"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "files": [
        "!node_modules/node-pty/prebuilds/win32-*/**",
        "!node_modules/node-pty/prebuilds/darwin-*/**"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "samuelwbarber",
      "repo": "limpet",
      "releaseType": "release"
    }
  }
}
